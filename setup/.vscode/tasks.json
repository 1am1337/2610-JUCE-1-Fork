{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure setup",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "Unix Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "windows": {
                "args": [
                    "-S",
                    ".",
                    "-B",
                    "build",
                    "-G",
                    "NMake Makefiles",
                    "-DCMAKE_BUILD_TYPE=Debug"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build setup",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Configure setup",
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
