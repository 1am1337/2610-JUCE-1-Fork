{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lesson",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "-O0",
                "source/main.cpp",
                "source/Tempo.cpp",
                "-o",
                "main"
            ],
            "osx": {
                "command": "clang++"
            },
            "windows": {
                "command": "cl.exe",
                "args": [
                    "/nologo",
                    "/EHsc",
                    "/std:c++17",
                    "/Zi",
                    "/Od",
                    "source/main.cpp",
                    "source/Tempo.cpp",
                    "/Fe:main.exe",
                    "/link",
                    "/DEBUG"
                ],
                "problemMatcher": [
                    "$msCompile"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
